 353:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****         // rx_sample = digitalRead(RxPin);
 354:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****         // caoxp@github,
 355:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****         // add filter.
