 366:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****         // check sample transition
 367:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****         uint8_t transition = (rx_sample != rx_last_sample);
 368:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c **** 
 369:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****         if (rx_mode == RX_MODE_PRE)
 370:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****         {
 371:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****             // Wait for first transition to HIGH
 372:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****             if (transition && (rx_sample == 1))
