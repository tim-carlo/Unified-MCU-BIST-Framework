 374:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c **** static void AddManBit(volatile uint16_t *manBits, volatile uint8_t *numMB,
 375:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****                       volatile uint8_t *curByte, volatile uint8_t *data,
 376:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****                       uint8_t bit)
 377:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c **** {
 378:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****     *manBits <<= 1;
 379:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****     *manBits |= bit;
 380:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****     (*numMB)++;
 381:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****     if (*numMB == 16)
 382:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****     {
 383:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****         uint8_t newData = 0;
 384:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****         for (int8_t i = 0; i < 8; i++)
 385:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****         {
 386:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****             // ManBits holds 16 bits of manchester data
 387:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****             // 1 = LO,HI
 388:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****             // 0 = HI,LO
 389:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****             // We can decode each bit by looking at the bottom bit of each pair.
 390:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****             newData <<= 1;
 391:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****             newData |= (*manBits & 1); // store the one
 392:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****             *manBits = *manBits >> 2;  // get next data bit
 393:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****         }
 394:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****         data[*curByte] = newData ^ DECOUPLING_MASK;
 395:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****         (*curByte)++;
 396:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c **** 
 397:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****         // added by caoxp @ https://github.com/caoxp
 398:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****         // compatible with unfixed-length data, with the data length defined by the first byte.
 399:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****         // at a maximum of 255 total data length.
 400:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****         if ((*curByte) == 1)
 401:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****         {
 402:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****             rx_maxBytes = data[0];
 403:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****         }
 404:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c **** 
 405:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****         *numMB = 0;
