   1:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c **** /*
   2:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c **** This code is based on the Atmel Corporation Manchester
   3:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c **** Coding Basics Application Note.
   4:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c **** 
   5:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c **** http://www.atmel.com/dyn/resources/prod_documents/doc9164.pdf
   6:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c **** 
   7:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c **** Quotes from the application note:
   8:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c **** 
   9:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c **** "Manchester coding states that there will always be a transition of the message signal
  10:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c **** at the mid-point of the data bit frame.
  11:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c **** What occurs at the bit edges depends on the state of the previous bit frame and
  12:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c **** does not always produce a transition. A logical '1' is defined as a mid-point transition
  13:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c **** from low to high and a '0' is a mid-point transition from high to low.
  14:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c **** 
  15:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c **** We use Timing Based Manchester Decode.
  16:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c **** In this approach we will capture the time between each transition coming from the demodulation
  17:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c **** circuit."
  18:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c **** 
  19:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c **** Timer 2 is used with a ATMega328. Timer 1 is used for a ATtiny85.
  20:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c **** 
  21:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c **** This code gives a basic data rate as 1200 bauds. In manchester encoding we send 1 0 for a data bit 
  22:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c **** We send 0 1 for a data bit 1. This ensures an average over time of a fixed DC level in the TX/RX.
  23:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c **** This is required by the ASK RF link system to ensure its correct operation.
  24:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c **** The data rate is then 600 bits/s.
  25:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c **** */
  26:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c **** 
  27:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c **** #include "manchester.h"
  28:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c **** #include "nrf52840_helper.h"
  29:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c **** 
