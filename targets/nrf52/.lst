 392:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****                          ((rx_count < MinCount) || (rx_count > MaxLongCount)))
 393:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****                 {
 394:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****                     // 0 bits after the 20th bit are allowed to be a double bit
