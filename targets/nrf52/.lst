   7:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c **** #define LONG_BIT_US (1000000UL / BAUD_RATE)  // 500 us
   8:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c **** #define MID_BIT_US (LONG_BIT_US / 2)         // 250 us
