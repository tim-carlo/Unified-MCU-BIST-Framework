 455:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****                 {
 456:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****                     // First 20 bits and all 1 bits are expected to be regular
 457:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****                     // Transition was too slow/fast
