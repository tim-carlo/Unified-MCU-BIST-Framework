 310:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c **** static void AddManBit(volatile uint16_t *manBits, volatile uint8_t *numMB,
 311:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****                      volatile uint8_t *curByte, volatile uint8_t *data,
 312:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****                      uint8_t bit)
 313:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c **** {
 314:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****     *manBits <<= 1;
 315:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****     *manBits |= bit;
 316:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****     (*numMB)++;
 317:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****     if (*numMB == 16)
 318:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****     {
 319:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****         uint8_t newData = 0;
 320:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****         for (int8_t i = 0; i < 8; i++)
 321:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****         {
 322:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****             // ManBits holds 16 bits of manchester data
 323:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****             // 1 = LO,HI
 324:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****             // 0 = HI,LO
 325:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****             // We can decode each bit by looking at the bottom bit of each pair.
 326:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****             newData <<= 1;
 327:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****             newData |= (*manBits & 1); // store the one
 328:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****             *manBits = *manBits >> 2;  // get next data bit
 329:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****         }
 330:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****         data[*curByte] = newData ^ DECOUPLING_MASK;
 331:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****         (*curByte)++;
 332:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c **** 
 333:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****         // added by caoxp @ https://github.com/caoxp
 334:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****         // compatible with unfixed-length data, with the data length defined by the first byte.
 335:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****         // at a maximum of 255 total data length.
 336:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****         if ((*curByte) == 1)
 337:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****         {
 338:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****             rx_maxBytes = data[0];
 339:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****         }
 340:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c **** 
 341:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****         *numMB = 0;
 342:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****     }
 343:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c **** }
