 474:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****                     {
 475:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****                         // We have seen at least 10 regular transitions
 476:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****                         // Lock sequence ends with unencoded bits 01
 477:/Users/timcarlo/Desktop/testsoftware/common/utils/machester.c ****                         // This is encoded and TX as HI,LO,LO,HI
